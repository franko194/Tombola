# Backend persistence for shared use across PCs.
# Use a managed PostgreSQL connection string from Neon, Supabase, or Vercel Postgres.
DATABASE_URL=postgresql://usuario:password@host:5432/tombola?sslmode=require

# Optional when the API is consumed from another domain.
# The Vercel app calls /api on the same domain, so this is usually not required.
ALLOWED_ORIGINS=https://tombola-rust.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Public production URL used to generate judge QR links.
# Keep these pointing to the public Production domain, not a Vercel Preview URL.
PUBLIC_APP_URL=https://tombola-rust.vercel.app
VITE_PUBLIC_APP_URL=https://tombola-rust.vercel.app

# Do not set VITE_API_URL in Vercel production unless the API is hosted on another public domain.
# The Vercel deployment uses /api automatically.
# VITE_API_URL=http://127.0.0.1:8001

# Organizer login with email and password (stored in the organizers table). Judges do not log in.
# Long random string used to sign the login cookie.
SESSION_SECRET=una_cadena_larga_aleatoria
# Optional: emails added to the organizers table on startup if missing (set their password with app.set_organizer_password).
ORGANIZER_EMAILS=correo1@gmail.com,correo2@gmail.com

# Optional generative AI for team balance explanations.
# Without these values, or if the cloud call fails, the app uses a local deterministic explanation.
CLOUD_AI_URL=https://your-cloud-ai-url.example.com/api
CLOUD_AI_API_KEY=tu_api_key_de_ia
CLOUD_AI_MODEL=minimax-m3:cloud
